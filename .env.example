# ==============================================================================
# KATRYX LUXURY E-COMMERCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Firebase Web API keys are public client identifiers embedded in web apps.
# - DO NOT place private service accounts, payment secrets, or admin credentials
#   in client-accessible files.
# - Keep genuine private secrets in server environment variables or Firebase Secret Manager.
# ==============================================================================

# Firebase Public Web SDK Configuration (Client-side)
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForDocumentationOnly
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Local Firebase Emulator Suite (Set to true for offline local test runs)
USE_FIREBASE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# Production & Domain Guardrails
PRODUCTION_URL=https://katryx.vercel.app
AUTHORIZED_DOMAINS=localhost,127.0.0.1,katryx.vercel.app
